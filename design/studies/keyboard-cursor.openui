root = Stack([heading, comparison, decision, rules])
heading = StudyHeading("Synthetic study", "Keyboard path for every panel action", "A small panel that has only icon buttons: update all, one upgrade per tool, update safe services, and per-service release notes and update. Two ways to put the keyboard cursor on it. Tool and service names are invented; no live data.")
comparison = StudyGrid(2, [optionA, optionB])
optionA = StudyPanel("A. Cursor on the action buttons", "The highlight is the button itself, and the tooltip for the highlighted action is shown beside it, so an icon-only control says what it does.", "Chosen", [aRows, aTip])
aRows = StudyTable(["Row", "Actions on the row", "What is highlighted", "Enter runs"], [["Update all", "Update all", "The Update all button", "Upgrade every outdated tool"], ["node 22.1 to 22.2", "Upgrade", "The Upgrade button", "Upgrade node only"], ["terraform 1.9 to 1.10", "Upgrade", "The Upgrade button", "Upgrade terraform only"], ["Update 2 safe services", "Update", "The Update button", "Update the services with reviewed notes"], ["web-frontend 4.1 to 4.2", "Release notes, Update", "Release notes or Update; Left and Right switch", "Open notes, or update web-frontend"], ["cache 7.0 to 7.2 (needs review)", "Release notes, Update", "Update shows a confirm icon after the first Enter", "Arm the row; a second Enter updates"]])
aTip = StudyList([{"title":"Highlighted: Upgrade on terraform","state":"Tooltip shown","copy":"Upgrade terraform to the latest version. The tooltip appears beside the highlighted button when the keyboard put the cursor there.","link":"Same text the button shows under the pointer"}, {"title":"Pointer resting on Release notes","state":"No second tooltip","copy":"The button already explains itself under the pointer, so the keyboard cursor's tooltip stays quiet while the pointer is over any action button.","link":"One highlight and one tooltip at a time"}, {"title":"Update disabled while a queue runs","state":"Dimmed, key kept","copy":"The cursor stays on the update it was on; Enter does nothing until the button is enabled again.","link":"Release notes stay reachable"}])
optionB = StudyPanel("B. Cursor on the whole row", "The row is highlighted. Enter runs the row's primary action; a letter key opens release notes.", "Rejected", [bRows, bProblems])
bRows = StudyTable(["Row", "Highlight", "Enter", "Letter key"], [["Update all", "The whole line", "Upgrade every outdated tool", "None"], ["node 22.1 to 22.2", "The whole line", "Upgrade node", "None"], ["web-frontend 4.1 to 4.2", "The whole line", "Update web-frontend", "n opens release notes"], ["cache 7.0 to 7.2 (needs review)", "The whole line", "Arm, then update", "n opens release notes"]])
bProblems = StudyList([{"title":"The highlight does not show what Enter will do","state":"Ambiguous","copy":"A two-action row lights up as a whole, so the user cannot see whether Enter presses Update or Notes.","link":"The acting control is not the highlighted one"}, {"title":"A second action hides behind a letter","state":"Hidden","copy":"Release notes become a shortcut nobody can discover from the row, and the notes icon on screen is no longer a target.","link":"Needs separate help text"}, {"title":"Needs a row-level cursor surface","state":"New component","copy":"Each row would carry its own highlight and key handling next to buttons that already have a native highlight state.","link":"Duplicates the shell's button contract"}])
decision = StudyPanel("Why A", "Each target is the exact control that will act, a stack row has two actions, and it matches the shell's action-button cursor contract.", "Decision", [why])
why = StudyList([{"title":"Each target is the exact control that will act","state":"Direct","copy":"Enter presses the highlighted button and runs what a click on it runs, under the same enabled gate. Nothing the user cannot see is ever pressed.","link":"Safe for upgrades and for the two-step confirm"}, {"title":"A stack row has two actions","state":"Both visible","copy":"Release notes and Update are both on screen and both reachable with Left and Right, with no hidden letter keys.","link":"Rows with one action simply have one target"}, {"title":"It matches the shell's action-button contract","state":"Native","copy":"The shell's action button already paints a cursor state and reports pointer hover, so mouse and keyboard share one cursor and one highlight with no new chrome.","link":"No restyling and no new colours"}])
rules = StudyDetails("Cursor rules", "What the keys do, and what keeps an accidental Enter harmless.", [ruleTable, ruleNote])
ruleTable = StudyTable(["Situation", "Behaviour"], [["Panel opens", "The cursor is off and nothing is highlighted. Enter and Space do nothing."], ["First arrow key", "Switches the cursor on at the first enabled action without moving."], ["Up and Down, or k and j", "Move between rows and stop at the first and last row."], ["Left and Right, or h and l", "Move between the actions on a row and stop at its ends."], ["A button is disabled", "Moves skip it. If the cursor is already there it stays, and Enter does nothing until it is enabled."], ["The list refreshes", "The cursor stays on the same action. If that action is gone it moves to the nearest action in its section, else the section before, else it switches off."], ["Pointer enters a button", "Once the pointer has really moved since the panel opened or a key last moved the cursor, the shared cursor moves there and the button shows its own tooltip. A pointer resting where a button appears does nothing. Leaving the button clears a cursor the pointer placed; a cursor the keys placed stays."], ["Enter or Space held down", "One activation per key press. Repeats are ignored until the key is released, so the confirm step of a review-required update cannot be skipped."], ["Esc and Tab", "Esc closes the panel. Tab moves to the next bar panel."]])
ruleNote = StudyNote("Study only: the real panel keeps its native buttons, services and confirmations. Which actions are visible and enabled still comes from the panel's own state; this study invents all values.")
